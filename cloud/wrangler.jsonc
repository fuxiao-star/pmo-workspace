{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pmo-workspace",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": true},
  "rules": [{"type": "Text", "globs": ["**/*.html"], "fallthrough": true}],
  "d1_databases": [{"binding": "DB", "database_name": "pmo-workspace", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}]
}
